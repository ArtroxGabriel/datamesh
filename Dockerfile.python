# syntax=docker/dockerfile:1

ARG PYTHON_VERSION=3.12
ARG DEBIAN_SUITE=bookworm

# Stage 1: Dedicated Builder with Astral uv
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-${DEBIAN_SUITE}-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-dev

# Stage 2: Minimal Runtime without uv or build tools
FROM python:${PYTHON_VERSION}-slim-${DEBIAN_SUITE} AS runtime

RUN groupadd --gid 10001 appgroup && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin appuser && \
    mkdir -p /app/data && \
    chown -R 10001:10001 /app

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 gen/python /app/gen/python
COPY --chown=10001:10001 common /app/common
COPY --chown=10001:10001 gateway /app/gateway
COPY --chown=10001:10001 sources /app/sources
COPY --chown=10001:10001 client /app/client

ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app:/app/gen/python"

USER 10001:10001
STOPSIGNAL SIGTERM

CMD ["python", "-m", "gateway.main"]
