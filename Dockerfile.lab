FROM docker:27-cli AS docker-cli
FROM golang:1.23 AS build-pdu
WORKDIR /app
COPY go.work ./
COPY sources/pdu/go.mod sources/pdu/go.sum ./sources/pdu/
COPY gen/go/go.mod ./gen/go/
RUN go mod download -C sources/pdu
COPY gen/go/ ./gen/go/
COPY sources/pdu/ ./sources/pdu/
RUN CGO_ENABLED=0 go build -o /pdu ./sources/pdu/cmd

FROM python:3.12-slim AS python-lab
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'fastapi>=0.115.0' 'grpcio>=1.68.0' 'protobuf>=5.29.0' 'uvicorn>=0.32.0' 'cryptography>=50.0.2'
COPY common ./common
COPY gateway ./gateway
COPY client ./client
COPY sources ./sources
COPY gen/python ./gen/python
COPY scripts/attacks ./scripts/attacks
COPY lab ./lab
COPY scripts/security/container-entrypoint.sh /usr/local/bin/lab-entrypoint
ENTRYPOINT ["/usr/local/bin/lab-entrypoint"]
ENV PYTHONPATH=/app:/app/gen/python

FROM python-lab AS lab
COPY --from=build-pdu /pdu /usr/local/bin/pdu

FROM lab AS controller
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
